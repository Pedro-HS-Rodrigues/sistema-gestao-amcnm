# Copie este arquivo para .env e ajuste os valores.
# Carregue no terminal com:  set -a; source .env; set +a

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção com HTTPS (deixe False/0 no desenvolvimento local)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_ATRAS_DE_PROXY=False

# PostgreSQL (se POSTGRES_DB ficar vazio, o projeto usa SQLite para testes rápidos)
POSTGRES_DB=amcnm
POSTGRES_USER=amcnm
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Produção (ex.: Neon): uma única URL de conexão; tem prioridade sobre POSTGRES_*.
# Guarde o valor real só em .env.local ou nas variáveis do servidor, nunca no Git.
# DATABASE_URL=
